# §4 — LEAVE-ONE-OUT (opcional; escala-agnóstico via yi/sei)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

run_loo_analysis <- function(dat, full_model, mu_mean, mu_sd, tau_prior_func, labels, out_dir, sheet_name, cfg) {
  K <- nrow(dat); eff_lb <- cfg$eff_lab
  plan(multisession); on.exit(plan(sequential), add = TRUE)
  loo_list <- future_lapply(seq_len(K), function(i) {
    fit <- bayesmeta(y = dat$yi[-i], sigma = dat$sei[-i], labels = labels[-i],
                     mu.prior.mean = mu_mean, mu.prior.sd = mu_sd, tau.prior = tau_prior_func)
    list(study_excluded = labels[i],
         estimate = trans_inv(fit$summary["median","mu"], cfg$link),
         ci_lower = trans_inv(fit$summary["95% lower","mu"], cfg$link),
         ci_upper = trans_inv(fit$summary["95% upper","mu"], cfg$link),
         tau_median = fit$summary["median","tau"])
  }, future.seed = TRUE)
  loo_res <- data.frame(
    study_excluded = sapply(loo_list, `[[`, "study_excluded"), estimate = sapply(loo_list, `[[`, "estimate"),
    ci_lower = sapply(loo_list, `[[`, "ci_lower"), ci_upper = sapply(loo_list, `[[`, "ci_upper"),
    tau_median = sapply(loo_list, `[[`, "tau_median"), stringsAsFactors = FALSE
  )
  full_mu <- trans_inv(full_model$summary["median","mu"], cfg$link)
  full_lo <- trans_inv(full_model$summary["95% lower","mu"], cfg$link)
  full_hi <- trans_inv(full_model$summary["95% upper","mu"], cfg$link)
  m_ref <- metagen(sm = cfg$sm, TE = trans_fwd(c(loo_res$estimate, full_mu), cfg$link),
                   lower = trans_fwd(c(loo_res$ci_lower, full_lo), cfg$link),
                   upper = trans_fwd(c(loo_res$ci_upper, full_hi), cfg$link),
                   studlab = c(paste0("Omitting: ", loo_res$study_excluded), "Full Analysis (Reference)"),
                   random = FALSE, common = FALSE)
  sq_col <- c(rep("steelblue", K), "firebrick"); loo_h <- max(10, (K + 1) * 0.45 + 5)
  save_plot("Supp_Fig_5_LOO_Forest", function() {
    meta::forest(m_ref, leftcols = "studlab", leftlabs = "Study", rightcols = c("effect","ci"),
                 rightlabs = c(eff_lb, "95% CrI"), xlab = cfg$x_label, smlab = "", weight.study = "same",
                 col.square = sq_col, col.square.lines = sq_col, overall = FALSE, hetstat = FALSE, overall.hetstat = FALSE)
  }, out_dir, height = loo_h)
  fmt <- function(e, lo, hi) sprintf("%8.3f [%8.3f, %8.3f]", e, lo, hi)
  hdr <- sprintf("%-32s | %-30s | %s", "Study Excluded", paste0(eff_lb, " [95% CrI]"), "tau (median)")
  rows <- vapply(seq_len(nrow(loo_res)), function(i) {
    r <- loo_res[i, ]; sprintf("%-32s | %-30s | %.3f", r$study_excluded, fmt(r$estimate, r$ci_lower, r$ci_upper), r$tau_median)
  }, character(1))
  ref_row <- sprintf("%-32s | %-30s | %s", "Full Analysis (Reference)", fmt(full_mu, full_lo, full_hi), "-")
  save_docx("Supp_Table_2_LOO_Results", c(paste0("LOO: ", sheet_name), paste(rep("-",80),collapse=""),
                                          hdr, paste(rep("-",80),collapse=""), rows, paste(rep("-",80),collapse=""), ref_row), out_dir)
}


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# §5 — ANÁLISE UNIFICADA (MD e RR) POR ABA
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

run_analysis <- function(sheet, cfg, base_dir = output_dir) {
  
  dat <- tryCatch(as.data.frame(read_sheet(url, sheet = sheet)) |> janitor::clean_names(),
                  error = function(e) { log_error(paste0("read_sheet — ", sheet), e$message); NULL })
  if (is.null(dat)) return(invisible(NULL))
  
  out_dir_main <- file.path(base_dir, sheet)
  out_dir_meth <- file.path(out_dir_main, "Supplementary_Methods")
  out_dir_resu <- file.path(out_dir_main, "Supplementary_Results")
  dir.create(out_dir_meth, showWarnings = FALSE, recursive = TRUE)
  dir.create(out_dir_resu, showWarnings = FALSE, recursive = TRUE)
  
  # ── Rótulos + escalc por escala ───────────────────────────────────────────
  if (cfg$scale == "MD") {
    labels <- trimws(as.character(dat$source))
    keep   <- !is.na(labels) & nzchar(labels)                 # descarta linhas sem rótulo/vazias
    dat    <- dat[keep, ]; labels <- labels[keep]
    for (col in c("m1i","sd1i","n1i","m2i","sd2i","n2i")) dat[[col]] <- num(dat[[col]])  # força numérico
    dd <- escalc(measure = "MD", m1i = m1i, sd1i = sd1i, n1i = n1i, m2i = m2i, sd2i = sd2i, n2i = n2i, data = dat) |> data.frame()
  } else { # RR
    labels <- trimws(paste(dat$author, dat$year))
    keep   <- !is.na(dat$author) & nzchar(trimws(as.character(dat$author)))
    dat    <- dat[keep, ]; labels <- labels[keep]
    if (!("ci" %in% names(dat)) && ("a2" %in% names(dat))) dat$ci <- dat$a2  # eventos grupo 2: 'ci' OU 'a2'
    for (col in c("ai","n1i","ci","n2i")) dat[[col]] <- num(dat[[col]])       # força numérico
    dd <- escalc(measure = "RR", ai = ai, n1i = n1i, ci = ci, n2i = n2i, data = dat) |> data.frame()
  }
  dd$sei <- sqrt(dd$vi)
  ok <- is.finite(dd$yi) & is.finite(dd$sei)   # máscara ANTES de filtrar (mantém labels alinhados)
  dd <- dd[ok, ]; labels <- labels[ok]
  if (nrow(dd) < 2) stop("Menos de 2 estudos validos em '", sheet, "'.")
  
  pr <- resolve_priors(cfg)
  
  # ── Modelos ────────────────────────────────────────────────────────────────
  bm <- function(tau_fn, mu_mean, mu_sd) bayesmeta(y = dd$yi, sigma = dd$sei, labels = labels,
                                                   mu.prior.mean = mu_mean, mu.prior.sd = mu_sd, tau.prior = tau_fn)
  meta_primary    <- bm(pr$tau_weakly,     cfg$mu_vague_mean, cfg$mu_vague_sd)   # vago mu + weakly tau (PRIMÁRIO)
  meta_sens       <- bm(pr$tau_vague,      0,                 pr$mu_sens_sd)     # sensibilidade do prior de MU
  meta_restricted <- bm(pr$tau_restricted, cfg$mu_vague_mean, cfg$mu_vague_sd)   # tau restrito
  meta_vague_tau  <- bm(pr$tau_vague,      cfg$mu_vague_mean, cfg$mu_vague_sd)   # tau vago (mu vago fixo)
  ee <- metafor::rma(yi = dd$yi, vi = dd$vi, method = "EE", slab = labels)       # Common-Effect (piso)
  ee_est <- as.numeric(ee$beta); ee_se <- as.numeric(ee$se); ee_lo <- as.numeric(ee$ci.lb); ee_hi <- as.numeric(ee$ci.ub)
  
  post_prim <- get_summary(meta_primary); post_sens <- get_summary(meta_sens)
  
  # ── Forest base ─────────────────────────────────────────────────────────────
  if (cfg$scale == "MD") {
    forest_base <- metacont(data = dd, studlab = labels, mean.e = m1i, sd.e = sd1i, n.e = n1i,
                            mean.c = m2i, sd.c = sd2i, n.c = n2i, sm = "MD", common = FALSE, random = FALSE)
    left_cols <- c("studlab","mean.e","sd.e","n.e","mean.c","sd.c","n.c","effect.ci")
    left_labs <- c("Study", NA, NA, NA, NA, NA, NA, cfg$eff_lab)
  } else {
    forest_base <- metabin(data = dd, studlab = labels, event.e = ai, n.e = n1i, event.c = ci, n.c = n2i,
                           sm = "RR", common = FALSE, random = FALSE)
    left_cols <- c("studlab","event.e","n.e","event.c","n.c","effect.ci")
    left_labs <- c("Study","Events","N","Events","N", cfg$eff_lab)
  }
  
  mf_prim      <- metaadd(forest_base, type = "random",     TE = post_prim$mu_mean,    upper = post_prim$mu_upper,    lower = post_prim$mu_lower)
  mf_prim_pred <- metaadd(mf_prim,     type = "prediction", TE = post_prim$theta_mean, upper = post_prim$theta_upper, lower = post_prim$theta_lower)
  mf_sens      <- metaadd(forest_base, type = "random",     TE = post_sens$mu_mean,    upper = post_sens$mu_upper,    lower = post_sens$mu_lower)
  mf_sens_pred <- metaadd(mf_sens,     type = "prediction", TE = post_sens$theta_mean, upper = post_sens$theta_upper, lower = post_sens$theta_lower)  # FIX simetria
  
  analyses_names <- c("Primary (mu: vague / tau: weakly-informative)", "Sensitivity (mu: weakly-informative / tau: vague)")
  all_overall <- metabind(mf_prim,      mf_sens,      name = analyses_names)
  all_predict <- metabind(mf_prim_pred, mf_sens_pred, name = analyses_names)
  
  tau_fmt <- function(p) paste0("tau = ", round(p$tau_median,3), " [95% CrI ", round(p$tau_lower,3), ", ", round(p$tau_upper,3), "]")
  tau_prim_text <- tau_fmt(post_prim); tau_sens_text <- tau_fmt(post_sens)
  
  plots_prim <- generate_posterior_plots(meta_primary, "skyblue",   cfg)
  plots_pred <- generate_posterior_plots(meta_primary, "firebrick", cfg, is_predict = TRUE)
  
  # P(effect <= null) e complementar; null = 0 na escala do modelo (MD=0, RR: log(1)=0)
  report_null <- trans_inv(0, cfg$link)
  p_le <- round(as.numeric(meta_primary$pposterior(mu = 0)) * 100, 2)
  p_gt <- round((1 - as.numeric(meta_primary$pposterior(mu = 0))) * 100, 2)
  p_theta_le <- round(as.numeric(meta_primary$pposterior(theta = 0, predict = TRUE)) * 100, 2)
  p_theta_gt <- round((1 - as.numeric(meta_primary$pposterior(theta = 0, predict = TRUE))) * 100, 2)
  
  # ── Escada de heterogeneidade (isola tau; mu vago fixo) ─────────────────────
  scen_names <- c("Common-Effect: tau = 0 (frequentist)",
                  paste0("Restricted: tau ~ HN(", cfg$tau_restricted_scale, ")"),
                  paste0("Weakly-Informative: tau ~ HN(", round(pr$tau_weakly_scale, 2), ") [PRIMARY]"),
                  paste0("Vague: tau ~ HN(", round(pr$tau_vague_scale, 2), ")"))
  scen_models <- list(meta_restricted, meta_primary, meta_vague_tau)  # bayesmeta (após EE)
  
  scen_est_m <- c(ee_est, sapply(scen_models, function(m) m$summary["mean","mu"]))
  scen_lo_m  <- c(ee_lo,  sapply(scen_models, function(m) m$summary["95% lower","mu"]))
  scen_hi_m  <- c(ee_hi,  sapply(scen_models, function(m) m$summary["95% upper","mu"]))
  scen_tau   <- c(NA,     sapply(scen_models, function(m) m$summary["median","tau"]))
  
  m_scen <- metagen(sm = cfg$sm, TE = scen_est_m, lower = scen_lo_m, upper = scen_hi_m,
                    studlab = scen_names, random = FALSE, common = FALSE)
  scen_col <- c("firebrick","steelblue","steelblue","steelblue"); scen_h <- max(8, 4*0.6 + 4)
  save_plot("Supp_Fig_4_Heterogeneity_Scenarios", function() {
    meta::forest(m_scen, leftcols = "studlab", leftlabs = "Scenario (tau prior)",
                 rightcols = c("effect","ci"), rightlabs = c(cfg$eff_lab, "95% (Cr)I"),
                 xlab = cfg$x_label, smlab = "", weight.study = "same",
                 col.square = scen_col, col.square.lines = scen_col, overall = FALSE, hetstat = FALSE, overall.hetstat = FALSE)
  }, out_dir_resu, height = scen_h)
  
  fmt_ci <- function(e, lo, hi) sprintf("%8.3f [%8.3f, %8.3f]", e, lo, hi)
  scen_hdr <- sprintf("%-48s | %-30s | %-14s", "Scenario (tau prior)", paste0(cfg$eff_lab, " [95% (Cr)I]"), "tau (median)")
  scen_body <- vapply(seq_along(scen_names), function(i) {
    tau_txt <- if (is.na(scen_tau[i])) "0 (fixed)" else sprintf("%.3f", scen_tau[i])
    sprintf("%-48s | %-30s | %-14s", scen_names[i],
            fmt_ci(trans_inv(scen_est_m[i], cfg$link), trans_inv(scen_lo_m[i], cfg$link), trans_inv(scen_hi_m[i], cfg$link)), tau_txt)
  }, character(1))
  save_docx("Supp_Table_4_Heterogeneity_Scenarios", c(
    paste0("Outcome: ", sheet), "Supplementary Table 4 — Pooled Effect Across Heterogeneity-Prior Scenarios",
    paste(rep("-",96),collapse=""), scen_hdr, paste(rep("-",96),collapse=""), scen_body
  ), out_dir_resu)
  
  # ── ROPE (se definida) — sob TODOS os priors ────────────────────────────────
  if (!is.null(cfg$rope_primary)) {
    rope_rows_for <- function(bounds) list(
      rope_from_normal(ee_est, ee_se, ee_lo, ee_hi, bounds, cfg$link),
      rope_from_bayesmeta(meta_restricted, bounds, cfg$link),
      rope_from_bayesmeta(meta_primary,    bounds, cfg$link),
      rope_from_bayesmeta(meta_vague_tau,  bounds, cfg$link)
    )
    rope_lines <- c(
      paste0("Outcome: ", sheet), "Supplementary Table 3 — ROPE (Region of Practical Equivalence)",
      paste0("Report scale: ", ifelse(cfg$link == "log", "Risk Ratio", "Mean Difference")),
      paste(rep("=",124),collapse=""), "",
      rope_block("PRIMARY ROPE", cfg$rope_primary, rope_rows_for(cfg$rope_primary), scen_names, report_null)
    )
    if (!is.null(cfg$rope_sensitivity))
      rope_lines <- c(rope_lines, rope_block("SENSITIVITY ROPE", cfg$rope_sensitivity, rope_rows_for(cfg$rope_sensitivity), scen_names, report_null))
    save_docx("Supp_Table_3_ROPE_Analysis", rope_lines, out_dir_resu)
  }
  
  # ── Forest principal ────────────────────────────────────────────────────────
  n_studies <- nrow(dd); forest_height <- max(10, n_studies*0.4 + 5); sens_height <- max(8, 2*0.6 + 4)
  lbl <- get_forest_labels(sheet, label_left_common, label_right_common)
  
  save_plot("Figure_1_Forest_Primary", function() {
    meta::forest(mf_prim_pred, layout = "RevMan5", sortvar = labels, text.random = "Bayesian Summary",
                 text.predict = "Bayesian 95% Prediction Interval", text.addline1 = tau_prim_text, smlab = cfg$x_label,
                 digits.mean = 2, digits.sd = 2, leftcols = left_cols, leftlabs = left_labs, pooled.events = TRUE,
                 # Desliga a heterogeneidade FREQUENTISTA do pacote meta (ela sairia como "95%-CI").
                 # O tau BAYESIANO (95% CrI) e reportado via text.addline1 acima.
                 hetstat = FALSE, print.tau2 = FALSE, print.tau = FALSE, print.I2 = FALSE, print.Q = FALSE, print.pval.Q = FALSE,
                 label.e = label_e_common, label.c = label_c_common, label.left = lbl$left, label.right = lbl$right, colgap = "6mm")
  }, out_dir_main, height = forest_height)
  
  save_plot("Figure_2_Posterior_Dist", function() { print(plots_prim$density + plots_prim$probability) }, out_dir_main)
  
  post_lines <- c(
    paste0("Outcome: ", sheet), paste(rep("=",60),collapse=""), "",
    "Primary Analysis — Posterior Probabilities", paste(rep("-",50),collapse=""),
    sprintf("P(effect <= %.2f): %s%%", report_null, p_le), sprintf("P(effect >  %.2f): %s%%", report_null, p_gt),
    sprintf("P(theta <= %.2f) [predictive]: %s%%", report_null, p_theta_le),
    sprintf("P(theta >  %.2f) [predictive]: %s%%", report_null, p_theta_gt)
  )
  if (!is.null(cfg$rope_primary)) {
    prim_rope_p <- rope_from_bayesmeta(meta_primary, cfg$rope_primary, cfg$link)
    post_lines <- c(post_lines, "", "ROPE — Primary model", paste(rep("-",50),collapse=""),
                    sprintf("Primary ROPE [%.2f, %.2f]: P(inside) = %s%% | %s", cfg$rope_primary[1], cfg$rope_primary[2],
                            round(100*prim_rope_p$p_in,2), prim_rope_p$decision))
  } else {
    post_lines <- c(post_lines, "", "ROPE not reported for this outcome.")
  }
  save_docx("Posterior_Probabilities", post_lines, out_dir_main)
  
  save_docx("Model_Summaries", c(
    paste0("Outcome: ", sheet), paste(rep("=",60),collapse=""), "",
    "=== Primary: Vague Mu / Weakly Tau ===", capture.output(print(meta_primary$summary)), "",
    "=== Sensitivity (MU prior): Weakly Mu / Vague Tau ===", capture.output(print(meta_sens$summary)), "",
    paste0("=== Restricted Tau ~ HN(", cfg$tau_restricted_scale, ") / Vague Mu ==="), capture.output(print(meta_restricted$summary)), "",
    paste0("=== Vague Tau ~ HN(", round(pr$tau_vague_scale, 2), ") / Vague Mu ==="), capture.output(print(meta_vague_tau$summary)), "",
    "=== Common-Effect (equal-effects; tau^2 = 0; frequentist floor) ===", capture.output(print(ee))
  ), out_dir_main)
  
  # ── Priors viz (Supplementary_Methods) ──────────────────────────────────────
  tryCatch({
    plot_mu_primary  <- mu_dist_viz(mean = cfg$mu_vague_mean, sd = cfg$mu_vague_sd, scale = "absolute", xlabel = cfg$x_label)
    plot_tau_vague   <- tau_dist_viz(dist = "half-normal", scale = pr$tau_vague_scale)
    plot_tau_restr   <- tau_dist_viz(dist = "half-normal", scale = cfg$tau_restricted_scale)
    save_plot("01_Primary_Mu_Prior",   function() print(plot_mu_primary),  out_dir_meth, height = 6)
    save_plot("02_Vague_Tau_Prior",    function() print(plot_tau_vague),   out_dir_meth, height = 6)
    save_plot("03_Restricted_Tau_Prior", function() print(plot_tau_restr), out_dir_meth, height = 6)
  }, error = function(e) log_error(paste0("prior-viz — ", sheet), e$message))
  
  save_plot("Supp_Fig_1_Posterior_Predictive", function() { print(plots_pred$density + plots_pred$probability) }, out_dir_resu)
  save_plot("Supp_Fig_2_Sens_Overall_Effect",  function() { meta::forest(all_overall, smlab = paste0("Overall Effect (", cfg$eff_lab, ")"), leftcols = "studlab", hetstat = FALSE, overall.hetstat = FALSE) }, out_dir_resu, height = sens_height)
  save_plot("Supp_Fig_3_Sens_Predictive",      function() { meta::forest(all_predict, smlab = "95% Prediction Interval", leftcols = "studlab", hetstat = FALSE, overall.hetstat = FALSE) }, out_dir_resu, height = sens_height)
  
  save_docx("Supp_Table_1_Heterogeneity", c(
    paste0("Outcome: ", sheet), "Supplementary Table 1 — Between-Study Heterogeneity", paste(rep("-",80),collapse=""),
    paste0("Primary (Vague Mu / Weakly Tau):     ", tau_prim_text),
    paste0("Sensitivity (Weakly Mu / Vague Tau): ", tau_sens_text)
  ), out_dir_resu)
  
  # ── LOO (opcional) ──────────────────────────────────────────────────────────
  if (should_run_loo(sheet)) {
    tryCatch(run_loo_analysis(dat = dd, full_model = meta_primary, mu_mean = cfg$mu_vague_mean, mu_sd = cfg$mu_vague_sd,
                              tau_prior_func = pr$tau_weakly, labels = labels, out_dir = out_dir_resu, sheet_name = sheet, cfg = cfg),
             error = function(e) log_error(paste0("LOO — ", sheet), e$message))
  }
  invisible(NULL)
}


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# §6 — DISPATCH + EXECUTAR
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

for (oc in outcomes_to_run) {
  cfg <- outcome_registry[[oc]]
  if (is.null(cfg)) { log_error("registry", paste0("Desfecho nao encontrado: ", oc)); next }
  for (suf in cfg$subgroups) {
    sheet <- paste0(cfg$base, suf)
    tryCatch(run_analysis(sheet, cfg), error = function(e) log_error(sheet, e$message))
  }
}
