# Coerção robusta p/ numérico: trata list-columns do googlesheets4, texto e vírgula decimal
num <- function(x) {
  if (is.list(x)) x <- vapply(x, function(v) if (length(v) == 0 || is.null(v)) NA_character_ else as.character(v)[1], character(1))
  suppressWarnings(as.numeric(gsub(",", ".", trimws(as.character(x)))))
}

# Transformações de escala (identidade p/ MD, log p/ RR)
trans_fwd <- function(x, link) if (link == "log") log(x) else x
trans_inv <- function(x, link) if (link == "log") exp(x) else x

# Resolve priors do cfg em funções half-normal + parâmetros de mu
resolve_priors <- function(cfg) {
  # tau weakly e tau vague podem vir de ESCALA FIXA ou da FERRAMENTA (via "extremo").
  tau_weakly_scale <- if (!is.null(cfg$extreme_tau))       tau_prior_scale(cfg$extreme_tau)       else cfg$tau_weakly_scale
  tau_vague_scale  <- if (!is.null(cfg$extreme_tau_vague)) tau_prior_scale(cfg$extreme_tau_vague) else cfg$tau_vague_scale
  mu_sens_sd       <- if (!is.null(cfg$extreme_mu))        mu_prior_sd(cfg$extreme_mu)            else cfg$mu_sens_sd
  list(
    tau_weakly_scale = tau_weakly_scale, tau_vague_scale = tau_vague_scale, mu_sens_sd = mu_sens_sd,
    tau_weakly     = function(x) dhalfnormal(x, scale = tau_weakly_scale),
    tau_restricted = function(x) dhalfnormal(x, scale = cfg$tau_restricted_scale),
    tau_vague      = function(x) dhalfnormal(x, scale = tau_vague_scale)
  )
}

# Decisão HDI+ROPE (usa o CrI/IC central de 95% na escala do MODELO)
rope_decision <- function(ci_lo_m, ci_hi_m, lo_m, hi_m) {
  if (ci_lo_m >= lo_m && ci_hi_m <= hi_m)     "Practical equivalence (95% CrI within ROPE)"
  else if (ci_hi_m < lo_m || ci_lo_m > hi_m)  "Relevant difference (95% CrI outside ROPE)"
  else                                        "Undecided (95% CrI overlaps ROPE)"
}

# bounds_report = c(lo, hi) na escala de REPORTE; link define transformação p/ modelo
rope_from_bayesmeta <- function(model, bounds_report, link) {
  lo_m <- trans_fwd(bounds_report[1], link); hi_m <- trans_fwd(bounds_report[2], link)
  ci_lo_m <- model$summary["95% lower","mu"]; ci_hi_m <- model$summary["95% upper","mu"]
  list(
    p_in    = as.numeric(model$pposterior(mu = hi_m) - model$pposterior(mu = lo_m)),
    p_below = as.numeric(model$pposterior(mu = lo_m)),
    p_above = as.numeric(1 - model$pposterior(mu = hi_m)),
    ci_lo   = trans_inv(ci_lo_m, link), ci_hi = trans_inv(ci_hi_m, link),
    decision = rope_decision(ci_lo_m, ci_hi_m, lo_m, hi_m)
  )
}

# Análogo p/ o modelo Common-Effect (frequentista): aproximação normal (dist. de confiança)
rope_from_normal <- function(est_m, se_m, ci_lo_m, ci_hi_m, bounds_report, link) {
  lo_m <- trans_fwd(bounds_report[1], link); hi_m <- trans_fwd(bounds_report[2], link)
  list(
    p_in    = pnorm(hi_m, est_m, se_m) - pnorm(lo_m, est_m, se_m),
    p_below = pnorm(lo_m, est_m, se_m),
    p_above = 1 - pnorm(hi_m, est_m, se_m),
    ci_lo   = trans_inv(ci_lo_m, link), ci_hi = trans_inv(ci_hi_m, link),
    decision = rope_decision(ci_lo_m, ci_hi_m, lo_m, hi_m)
  )
}

# Gráficos posterior (densidade + P(effect <= x)) na escala do MODELO
generate_posterior_plots <- function(model, fill_color, cfg, is_predict = FALSE) {
  set.seed(123)
  samples <- model$rposterior(n = 10000, tau.sample = FALSE, predict = is_predict)
  cutoff_seq <- seq(cfg$x_range[1], cfg$x_range[2], length.out = 60)
  p_dens <- ggplot(data.frame(samples = samples), aes(x = samples)) +
    ggdist::stat_halfeye(.width = 0.95, point_interval = "mean_hdi", fill = fill_color) +
    labs(x = paste0("\n", cfg$x_label), y = "Density") + theme(axis.text.y = element_blank())
  probs <- if (is_predict) model$pposterior(theta = cutoff_seq, predict = TRUE) else model$pposterior(mu = cutoff_seq)
  p_prob <- ggplot(data.frame(cutoffs = cutoff_seq, probs = probs), aes(x = cutoffs, y = probs)) +
    geom_line() +
    scale_x_continuous(breaks = seq(cfg$x_range[1], cfg$x_range[2], by = cfg$x_by)) +
    scale_y_continuous(breaks = seq(0, 1, by = 0.2)) +
    labs(x = paste0("\n", cfg$x_label), y = expression("Probability effect" <= "X")) +
    theme(panel.grid.major.y = element_line(color = "gray80", linewidth = 0.3))
  list(density = p_dens, probability = p_prob)
}

# Bloco de tabela ROPE (texto largura fixa)
rope_block <- function(title, bounds_report, rows, scen_names, report_null) {
  sep <- paste(rep("-", 124), collapse = "")
  hdr <- sprintf("%-48s | %-9s | %-9s | %-9s | %-20s | %s",
                 "Scenario (tau prior)", "P(inside)", "P(below)", "P(above)", "95% (Cr)I", "Decision")
  body <- vapply(seq_along(rows), function(i) {
    r <- rows[[i]]
    sprintf("%-48s | %7.1f%%  | %7.1f%%  | %7.1f%%  | [%6.2f, %6.2f] | %s",
            scen_names[i], 100*r$p_in, 100*r$p_below, 100*r$p_above, r$ci_lo, r$ci_hi, r$decision)
  }, character(1))
  c(sprintf("%s  (ROPE = [%.2f, %.2f]; null = %.2f)", title, bounds_report[1], bounds_report[2], report_null),
    sep, hdr, sep, body, "")
}


