# §5 — ANÁLISE PRINCIPAL (Mean Difference - MMD)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

run_bayesian_meta <- function(sheet, base_dir = output_dir) {
  
  dat <- tryCatch({ as.data.frame(read_sheet(url, sheet = sheet)) |> janitor::clean_names() }, 
                  error = function(e) { log_error(paste0("read_sheet — ", sheet), e$message); NULL })
  if (is.null(dat)) return(invisible(NULL))
  
  out_dir_main <- file.path(base_dir, sheet)
  out_dir_meth <- file.path(out_dir_main, "Supplementary_Methods")
  out_dir_resu <- file.path(out_dir_main, "Supplementary_Results")
  dir.create(out_dir_meth, showWarnings = FALSE, recursive = TRUE)
  dir.create(out_dir_resu, showWarnings = FALSE, recursive = TRUE)
  
  # ── Dados ───────────────────────────────────────────────────────────────────
  # Padroniza a coluna de identificação (study ou source)
  label_col <- if("source" %in% names(dat)) "source" else "study"
  dat       <- dat[!is.na(dat[[label_col]]), ]
  
  dat_MD <- escalc(measure = "MD", m1i = m1i, sd1i = sd1i, n1i = n1i, m2i = m2i, sd2i = sd2i, n2i = n2i, data = dat) |> data.frame()
  dat_MD$sei <- sqrt(dat_MD$vi)
  
  if (nrow(dat_MD) < 2) stop("Menos de 2 estudos validos em '", sheet, "'.")
  
  # ── Priors Construídos via Função ──────────────────────────────────────────
  scale_tau_prim <- tau_prior_scale(extreme_tau_MD)
  sd_mu_sens     <- mu_prior_sd(extreme_mu_MD)
  
  prior_tau_weakly_func <- function(x) dhalfnormal(x, scale = scale_tau_prim)
  prior_tau_vague_func  <- function(x) dhalfnormal(x, scale = vague_tau_MD_scale)
  
  plot_mu_primary_prior  <- mu_dist_viz(mean = prior_mu_vague_mean_MD, sd = prior_mu_vague_sd_MD, scale = "absolute", xlabel = md_x_label)
  plot_tau_primary_prior <- tau_prior_plot(extreme_tau_MD)
  plot_mu_sens_prior     <- mu_dist_viz(mean = 0, sd = sd_mu_sens, scale = "absolute", xlabel = md_x_label)
  plot_tau_vague_prior   <- tau_dist_viz(dist = "half-normal", scale = vague_tau_MD_scale)
  
  # ── Modelos ──────────────────────────────────────────────────────────────────
  meta_MD_primary <- bayesmeta(y = dat_MD$yi, sigma = dat_MD$sei, labels = dat_MD[[label_col]],
                               mu.prior.mean = prior_mu_vague_mean_MD, mu.prior.sd = prior_mu_vague_sd_MD, tau.prior = prior_tau_weakly_func)
  meta_MD_sens    <- bayesmeta(y = dat_MD$yi, sigma = dat_MD$sei, labels = dat_MD[[label_col]],
                               mu.prior.mean = 0, mu.prior.sd = sd_mu_sens, tau.prior = prior_tau_vague_func)
  
  post_prim <- get_summary(meta_MD_primary)
  post_sens <- get_summary(meta_MD_sens)
  
  # ── Forest base ──────────────────────────────────────────────────────────────
  forest_data_MD <- metacont(data = dat_MD, studlab = dat_MD[[label_col]],
                             mean.e = m1i, sd.e = sd1i, n.e = n1i, mean.c = m2i, sd.c = sd2i, n.c = n2i,
                             sm = "MD", common = FALSE, random = FALSE)
  
  mf_prim      <- metaadd(forest_data_MD, type = "random", TE = post_prim$mu_mean, upper = post_prim$mu_upper, lower = post_prim$mu_lower)
  mf_prim_pred <- metaadd(mf_prim, type = "prediction", TE = post_prim$theta_mean, upper = post_prim$theta_upper, lower = post_prim$theta_lower)
  mf_sens      <- metaadd(forest_data_MD, type = "random", TE = post_sens$mu_mean, upper = post_sens$mu_upper, lower = post_sens$mu_lower)
  mf_sens_pred <- metaadd(forest_data_MD, type = "prediction", TE = post_sens$theta_mean, upper = post_sens$theta_upper, lower = post_sens$theta_lower)
  
  analyses_names <- c("Primary: Vague Mu / Weakly-Informative Tau", "Sensitivity: Weakly-Informative Mu / Vague Tau")
  all_overall <- metabind(mf_prim,      mf_sens,      name = analyses_names)
  all_predict <- metabind(mf_prim_pred, mf_sens_pred, name = analyses_names)
  
  tau_fmt <- function(p) paste0("τ = ", round(p$tau_median, 2), " [95% CrI ", round(p$tau_lower, 2), ", ", round(p$tau_upper, 2), "]")
  tau_prim_text <- tau_fmt(post_prim)
  tau_sens_text <- tau_fmt(post_sens)
  
  plots_prim <- generate_posterior_plots_md(meta_MD_primary, "skyblue")
  plots_pred <- generate_posterior_plots_md(meta_MD_primary, "firebrick", is_predict = TRUE)
  
  p_mu_le0    <- round(meta_MD_primary$pposterior(mu    = 0)                      * 100, 2)
  p_mu_gt0    <- round((1 - meta_MD_primary$pposterior(mu    = 0))                * 100, 2)
  p_theta_le0 <- round(meta_MD_primary$pposterior(theta = 0, predict = TRUE)      * 100, 2)
  p_theta_gt0 <- round((1 - meta_MD_primary$pposterior(theta = 0, predict = TRUE)) * 100, 2)
  
  n_studies     <- nrow(dat_MD)
  forest_height <- max(10, n_studies * 0.4 + 5)
  sens_height   <- max(8,  2 * 0.6 + 4)
  lbl           <- get_forest_labels(sheet, label_left_MD, label_right_MD)
  
  # ── Exportações — Fase 1 ──────────────────────────────────────────────────
  save_plot("Figure_1_Forest_Primary", function() {
    meta::forest(mf_prim_pred, layout = "RevMan5", sortvar = dat_MD[[label_col]], text.random = "Bayesian Summary",
                 text.predict = "Bayesian 95% Prediction Interval", text.addline1 = tau_prim_text, smlab = "Mean Difference (MMD)",
                 digits.mean = 2, digits.sd = 2, leftcols = c("studlab","mean.e","sd.e","n.e","mean.c","sd.c","n.c","effect.ci"),
                 leftlabs = c("Study", NA, NA, NA, NA, NA, NA, "MD"), pooled.events = TRUE,
                 label.e = label_e_MD, label.c = label_c_MD, label.left = lbl$left, label.right = lbl$right, colgap = "6mm")
  }, out_dir_main, height = forest_height)
  
  save_plot("Figure_2_Posterior_Dist", function() { print(plots_prim$density + plots_prim$probability) }, out_dir_main)
  
  save_docx("Posterior_Probabilities", c(
    paste0("Outcome: ", sheet), paste(rep("=", 60), collapse = ""), "",
    "Primary Analysis — Posterior Probabilities", paste(rep("-", 50), collapse = ""),
    paste0("P(MD <= 0): ", p_mu_le0,    "%"), paste0("P(MD >  0): ", p_mu_gt0,    "%"),
    paste0("P(theta <= 0) [predictive]: ", p_theta_le0, "%"), paste0("P(theta >  0) [predictive]: ", p_theta_gt0, "%")
  ), out_dir_main)
  
  save_docx("Model_Summaries", c(
    paste0("Outcome: ", sheet), paste(rep("=", 60), collapse = ""), "",
    paste0("=== Primary: Vague Mu / Weakly Tau [extreme_diff=", extreme_tau_MD, "] ==="),
    capture.output(print(meta_MD_primary$summary)), "",
    paste0("=== Sensitivity: Weakly Mu [extreme_diff=", extreme_mu_MD, "] / Vague Tau [Half-Normal(", vague_tau_MD_scale, ")] ==="),
    capture.output(print(meta_MD_sens$summary))
  ), out_dir_main)
  
  save_plot("01_Primary_Priors", function() { print(plot_mu_primary_prior / plot_tau_primary_prior) }, out_dir_meth, height = 12)
  save_plot("02_Sensitivity_Priors", function() { print(plot_mu_sens_prior / plot_tau_vague_prior) }, out_dir_meth, height = 12)
  save_plot("Supp_Fig_1_Posterior_Predictive", function() { print(plots_pred$density + plots_pred$probability) }, out_dir_resu)
  save_plot("Supp_Fig_2_Sens_Overall_Effect", function() { meta::forest(all_overall, smlab = "Overall Effect (MD)", leftcols = "studlab") }, out_dir_resu, height = sens_height)
  save_plot("Supp_Fig_3_Sens_Predictive", function() { meta::forest(all_predict, smlab = "95% Prediction Interval", leftcols = "studlab") }, out_dir_resu, height = sens_height)
  
  save_docx("Supp_Table_1_Heterogeneity", c(
    paste0("Outcome: ", sheet), "Supplementary Table 1 — Between-Study Heterogeneity", paste(rep("-", 80), collapse = ""),
    paste0("Primary (Vague Mu / Weakly Tau):     ", tau_prim_text), paste0("Sensitivity (Weakly Mu / Vague Tau): ", tau_sens_text)
  ), out_dir_resu)
  
  # ── Fase 2 — LOO manual ──────────────────────────────────────────────────────
  if (should_run_loo(sheet)) {
    tryCatch(
      run_loo_analysis(dat = dat_MD, full_model = meta_MD_primary, mu_mean = prior_mu_vague_mean_MD, mu_sd = prior_mu_vague_sd_MD,
