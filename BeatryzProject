# §4 — FASE 2: Leave-One-Out (LOO) 
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

run_loo_analysis <- function(dat, full_model, mu_mean, mu_sd, tau_prior_func, label_col, out_dir, sheet_name) {
  K      <- nrow(dat)
  eff_lb <- "MD"
  
  plan(multisession)
  on.exit(plan(sequential), add = TRUE)
  
  loo_list <- future_lapply(seq_len(K), function(i) {
    dat_loo <- dat[-i, ]
    fit     <- bayesmeta(y = dat_loo$yi, sigma = dat_loo$sei, labels = dat_loo[[label_col]],
                         mu.prior.mean = mu_mean, mu.prior.sd = mu_sd, tau.prior = tau_prior_func)
    list(study_excluded = dat[[label_col]][i], estimate = fit$summary["median", "mu"],
         ci_lower = fit$summary["95% lower", "mu"], ci_upper = fit$summary["95% upper", "mu"],
         tau_median = fit$summary["median", "tau"])
  }, future.seed = TRUE)
  
  loo_res <- data.frame(
    study_excluded = sapply(loo_list, `[[`, "study_excluded"), estimate = sapply(loo_list, `[[`, "estimate"),
    ci_lower = sapply(loo_list, `[[`, "ci_lower"), ci_upper = sapply(loo_list, `[[`, "ci_upper"),
    tau_median = sapply(loo_list, `[[`, "tau_median"), stringsAsFactors = FALSE
  )
  
  full_mu    <- full_model$summary["median", "mu"]
  full_mu_lo <- full_model$summary["95% lower", "mu"]
  full_mu_hi <- full_model$summary["95% upper", "mu"]
  
  m_ref <- metagen(sm = "MD", TE = c(loo_res$estimate, full_mu), lower = c(loo_res$ci_lower, full_mu_lo),
                   upper = c(loo_res$ci_upper, full_mu_hi), studlab = c(paste0("Omitting: ", loo_res$study_excluded), "Full Analysis (Reference)"),
                   random = FALSE, fixed = FALSE)
  
  sq_col <- c(rep("steelblue", K), "firebrick")
  loo_h  <- max(10, (K + 1) * 0.45 + 5)
  
  save_plot("Supp_Fig_5_LOO_Forest", function() {
    meta::forest(m_ref, leftcols = "studlab", leftlabs = "Study", rightcols = c("effect", "ci"),
                 rightlabs = c(eff_lb, "95% CrI"), xlab = "Mean Difference (MMD)", smlab = "", weight.study = "same",
                 col.square = sq_col, col.square.lines = sq_col, overall = FALSE, print.tau2 = FALSE, print.I2 = FALSE,
                 print.pval.Q = FALSE, hetstat = FALSE, overall.hetstat = FALSE)
  }, out_dir, height = loo_h)
  
  fmt <- function(e, lo, hi) sprintf("%6.2f [%6.2f, %6.2f]", e, lo, hi)
  hdr <- sprintf("%-32s | %-22s | %s", "Study Excluded", paste0(eff_lb, " [95% CrI]"), "tau (median)")
  rows <- vapply(seq_len(nrow(loo_res)), function(i) {
    r <- loo_res[i, ]
    sprintf("%-32s | %-22s | %.3f", r$study_excluded, fmt(r$estimate, r$ci_lower, r$ci_upper), r$tau_median)
  }, character(1))
  ref_row <- sprintf("%-32s | %-22s | %s", "Full Analysis (Reference)", fmt(full_mu, full_mu_lo, full_mu_hi), "—")
  
  save_docx("Supp_Table_2_LOO_Results", c(
    paste0("LOO Sensitivity Analysis: ", sheet_name), paste(rep("-", 72), collapse = ""), hdr,
    paste(rep("-", 72), collapse = ""), rows, paste(rep("-", 72), collapse = ""), ref_row
  ), out_dir)
}


